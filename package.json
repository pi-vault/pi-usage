{
  "name": "@pi-vault/pi-usage",
  "version": "0.1.0",
  "type": "module",
  "description": "Pi extension that displays aggregated usage statistics across all sessions",
  "author": "Lanh Hoang <lanhhoang@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/pi-vault/pi-usage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi-vault/pi-usage.git"
  },
  "bugs": {
    "url": "https://github.com/pi-vault/pi-usage/issues"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-usage"
  ],
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run --exclude tests/**/*.smoke.test.ts",
    "check": "biome lint . && tsc --noEmit && vitest --run --exclude tests/**/*.smoke.test.ts",
    "pack:dry-run": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "src",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "@earendil-works/pi-tui": "^0.78.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "@earendil-works/pi-tui": "^0.78.0",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
